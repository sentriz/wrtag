exec tag write kat_moda/01.flac title 'trk 1'
exec tag write kat_moda/02.flac title 'trk 2'
exec tag write kat_moda/03.flac title 'trk 3'

exec tag write kat_moda/*.flac musicbrainz_albumid 'e47d04a4-7460-427d-a731-cc82386d85f1'

# glob chars in the source dir name itself should be treated literally
mv kat_moda 'kat_moda [2020]'

env WRTAG_PATH_FORMAT='albums/{{ .Release.Title | safepath }}/{{ .Track.Position }}{{ .Ext }}'
env WRTAG_KEEP_FILE='*.log,extras/*.txt,notes [v2].txt,*.flac'

# globs match arbitrary names and in sub dirs, exact names with glob chars still work,
# and a pattern matching tracks doesn't duplicate them
exec wrtag copy -yes 'kat_moda [2020]/'
exec find albums
stdout '^albums/Kat Moda/Jeff Mills - Kat Moda.log$'
stdout '^albums/Kat Moda/extras/notes.txt$'
stdout '^albums/Kat Moda/notes \[v2\].txt$'
! stdout 'not-kept'
! stdout '01.flac'

# bad patterns are rejected up front
env WRTAG_KEEP_FILE='[bad'
! exec wrtag copy -yes albums/
stderr 'invalid keep file pattern'

-- kat_moda/Jeff Mills - Kat Moda.log --
rip log
-- kat_moda/extras/notes.txt --
some notes
-- kat_moda/notes [v2].txt --
literal name with glob chars
-- kat_moda/not-kept.txt --
please delete me
